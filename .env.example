APP_URL=http://localhost:8765
OAUTH_SERVER_URL=http://localhost:8080
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_PUBLIC_KEY_FILE=var/oauth-public.pem
OAUTH_INTERNAL_URL=

# --- YouTube : cookies d'un compte jetable (facultatif, docs/youtube-cookies.md) ---
# Contre « Sign in to confirm you're not a bot ». Vide = sans cookies.
YTDL_COOKIES_FILE=
# YTDL_COOKIES_FILE=var/youtube/cookies.txt

# --- Docker en développement uniquement (ne pas mettre en prod) ---
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# --- Limites ---
# Téléchargements simultanés
MAX_ACTIVE_JOBS=3
# Taille max d'un fichier (vide = pas de limite), ex. 2G, 500M
MAX_FILESIZE=4G
# Espace disque libre minimum (Mo) pour accepter un téléchargement
MIN_FREE_MB=2048
