# Protection par le serveur OAuth2 (SSO). Copier en .env et compléter.
# Laisser OAUTH_SERVER_URL vide (ou absent) = pas d'authentification (usage local).

# URL publique de l'application, sans / final (la redirect URI est APP_URL/auth/callback)
APP_URL=http://localhost:8765
# URL du serveur OAuth2 (aussi l'émetteur « iss » des logout tokens, sinon OAUTH_ISSUER)
OAUTH_SERVER_URL=http://localhost:8080
OAUTH_CLIENT_ID=yt-dl-dev
OAUTH_CLIENT_SECRET=
# Clé publique du serveur : make public-key > var/oauth-public.pem  (prod : make prod-public-key)
OAUTH_PUBLIC_KEY_FILE=var/oauth-public.pem
# Sessions, révocations : SQLite local
# OAUTH_STATE_DB=var/oauth_state.sqlite3
# Refuser de démarrer sans OAUTH_SERVER_URL (activé d'office dans l'image Docker)
# REQUIRE_AUTH=1
# Appels serveur à serveur (/token, /api/userinfo) si l'adresse diffère de OAUTH_SERVER_URL
# OAUTH_INTERNAL_URL=
# Secret lu depuis un fichier plutôt que OAUTH_CLIENT_SECRET
# OAUTH_CLIENT_SECRET_FILE=
# Limites : téléchargements simultanés, taille max d'un fichier, espace libre minimum (Mo)
# MAX_ACTIVE_JOBS=3
# MAX_FILESIZE=4G
# MIN_FREE_MB=1024
