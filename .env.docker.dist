# Configuration Docker de yt-dl. Copier en .env.docker (make init) et compléter.
# Les secrets ne vont PAS ici : voir secrets/ (make secret, make public-key).
# Le nom du réseau Docker du serveur OAuth (OAUTH_NETWORK) ne va pas ici non plus :
# Compose le lit dans .env ou le shell. Serveur OAuth dans /var/www/vauban → réseau vauban_default :
#   echo OAUTH_NETWORK=vauban_default > .env

# URL publique de l'application, sans / final (redirect URI = APP_URL/auth/callback).
# En https, le cookie de session devient Secure et HSTS est envoyé.
APP_URL=http://localhost:8765

# Serveur OAuth2 vu par le navigateur (/authorize, /logout) ; aussi l'émetteur
# « iss » des logout tokens (sinon OAUTH_ISSUER).
OAUTH_SERVER_URL=http://localhost:8080
# Le même, vu depuis le conteneur (appels /token, /api/userinfo) via le réseau Docker partagé.
OAUTH_INTERNAL_URL=http://php:8080
# OAUTH_ISSUER=
OAUTH_CLIENT_ID=yt-dl

# Limites
MAX_ACTIVE_JOBS=3
# Taille max d'un fichier téléchargé (vide = pas de limite), ex. 2G, 500M
MAX_FILESIZE=4G
# Espace libre minimum (Mo) pour accepter un téléchargement
MIN_FREE_MB=2048
